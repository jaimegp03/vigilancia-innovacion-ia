# Copia este archivo a .env y rellena los valores. NO subas .env a ningún repositorio.
# Las claves (Anthropic, Google, Telegram) NO van aquí: se crean como credenciales dentro de n8n.

# Clave para cifrar las credenciales guardadas en n8n.
# Genera una con: openssl rand -hex 32   (si la cambias después, pierdes las credenciales guardadas)
N8N_ENCRYPTION_KEY=

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Madrid

# ID del Google Sheet (el tramo largo de la URL entre /d/ y /edit)
GOOGLE_SHEET_ID=

# ID del chat de Telegram que recibirá el resumen semanal (no es un secreto, pero es personal)
TELEGRAM_CHAT_ID=
